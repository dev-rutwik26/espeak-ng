// Override 1: Indian English r = tap (ɾ), not approximant
phoneme r
  liquid rhotic
  lengthmod 3

  IF thisPh(isWordEnd) THEN
    ChangePhoneme(@)
  ELIF nextPhW(isVowel) THEN
    FMT(r/r)
  ELSE
    ChangePhoneme(@)
  ENDIF
  ipa ɾ
endphoneme

// Override 2: Indian English t = RETROFLEX stop (ʈ)
// NOTE: θ (theta) → t̪ (dental) is handled separately by the
// voice file's 'replace 00 T t[' rule. Native /t/ is retroflex.
phoneme t
  vls rfx stp
  voicingswitch d
  lengthmod 2
  ipa ʈ
  Vowelin f1=0  f2=1800 -300 300  f3=-400 80
  Vowelout f1=0 f2=1800 -300 250  f3=-400 80  rms=20
  WAV(ustop/t_short)
endphoneme

// Override 2b: Indian English d = RETROFLEX stop (ɖ)
// Standard English /d/ is alveolar; IndE uses retroflex ɖ
// Voiced stops use formant synthesis only (no WAV burst file)
phoneme d
  vcd rfx stp
  voicingswitch t
  lengthmod 5
  ipa ɖ
  Vowelin f1=1  f2=1800 -300 300  f3=-400 80
  Vowelout f1=1 f2=1800 -300 300  f3=-400 80

  IF PreVoicing THEN
    FMT(d/xdr)
  ENDIF

  IF nextPh(isPause2) THEN
    FMT(d/d_) addWav(x/d_)
  ENDIF

  FMT(d/dr)
endphoneme

// Override 3: oU diphthong → pure monophthong /o/
phoneme oU
  vwl starttype #o endtype #o
  ipa o
  length 200
  ChangeIfDiminished(@)
  FMT(vowel/o_2)
endphoneme

// Override 4: TRAP vowel a = more open /a/, not raised /æ/
phoneme a
  vwl starttype #a endtype #a
  ipa a
  length 180
  ChangeIfDiminished(a#)
  FMT(vowel/a_5)
endphoneme

// Override 5: STRUT vowel V = more open, toward /a/
phoneme V
  vwl starttype #a endtype #@
  ipa ɐ
  length 160
  ChangeIfDiminished(@)
  FMT(vowel/a#_3)
endphoneme

// Override 6: NURSE vowel 3: — remove IfNextVowelAppend(r-) to make non-rhotic
// butter/bird/turn should be bɐtə/bɜːd/tɜːn, not bɐtəɹ/bɜːɹd/tɜːɹn
phoneme 3:
  vwl starttype #@ endtype #@
  length 210
  ChangeIfDiminished(@)
  FMT(vowel/3_en)
endphoneme

// Override 7: FACE vowel eI = pure monophthong /eː/
// RP: /eɪ/ diphthong → IndE: /eː/ pure long vowel
// Examples: face /feːs/, cake /keːk/, day /deː/
phoneme eI
  vwl starttype #e endtype #e
  ipa eː
  length 230
  ChangeIfDiminished(e)
  FMT(vowel/e_2)
endphoneme

# ph_rutwik — define phoneme n. (retroflex nasal)
phoneme n.
  vcd rfx nas
  ipa ɳ
  Vowelin f1=2  f2=1800 -300 300  f3=-400 80
  Vowelout f1=2 f2=1800 -300 300
  FMT(n/n)          ← reuse alveolar nasal formants (close enough)
endphoneme

phoneme l.
  vcd rfx lat
  ipa ɭ
  FMT(l/l)    ← reuse lateral formants
endphoneme
