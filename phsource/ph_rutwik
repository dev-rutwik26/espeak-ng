phoneme r
  liquid rhotic
  lengthmod 3

  IF prevPh(isNotVowel) AND NOT prevPh(isPause) THEN
    CALL base1/r
  ELSE
    ipa ɾ
    FMT(r/r)
  ENDIF
endphoneme


phoneme aa
  vwl starttype #a endtype #a
  ipa ə
  length 110
  ChangeIfDiminished(@)
  FMT(vowel/a#)
endphoneme

phoneme a:
  vwl starttype #a endtype #a
  ipa aː
  length 300
  FMT(vowel/a_2)
endphoneme

phoneme t[
  vls dnt stp
  voicingswitch d[
  lengthmod 2
  Vowelin f1=0  f2=1400 -300 -200  f3=-100 80
  Vowelout f1=0 f2=1400 -300 -200  f3=-100 80 brk
  WAV(ustop/t_short)
endphoneme

phoneme d[
  vcd dnt stp
  voicingswitch t[
  lengthmod 5
  Vowelin f1=1  f2=1400 -300 -200  f3=-100 80
  Vowelout f1=1 f2=1400 -300 -200  f3=-100 80
  FMT(d/dr)
endphoneme
