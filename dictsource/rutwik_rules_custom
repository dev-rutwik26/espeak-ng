        e (_       e
        e          e

// ================================================================
// GROUP: ju
// Preserve /ju:/ glide
// Examples: use, unit, music
// ================================================================

.group ju
        ju (A      jU
        ju (_      jU
        ju         jU

// ================================================================
// GROUP: our
// Rhotic vowel in Indian English
// Examples: our, flower
// ================================================================

.group our
        our (_     a:r
        our (C     a:r
        our        a:r

// ================================================================
// GROUP: oon
// Preserve long /u:/
// Examples: moon, soon
// ================================================================

.group oon
        oon (_     u:
        oon (C     u:
        oon        u:





