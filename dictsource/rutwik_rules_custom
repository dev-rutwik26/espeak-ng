// rutwik_rules_custom - Indian English overrides
// These will be inserted between en_rules definitions and body

// ================================================================
// GROUP: er
// Fix: "er" before a vowel letter should keep r as a separate tap
// en_rules line 2764: er (A  →  3:r  (correct, but our phoneme r
// was dropping it). Now that ph_rutwik handles r correctly, we
// reinforce these rules explicitly.
// ================================================================

.group er
     &) er (_      %3      // word-end: schwa (non-rhotic)
    ll) ers (_S3   %3z
   all) er (_      3
    mb) er (_      3
    mm) er (_      3
    rn) er (_S2    3
    ss) er (_S2    3
    nc) er (_S1    3

        er (y      Er      // KEY: very, carry, sorry — y not in class A
        er (A      Er      // er before any vowel: keep e+r separate (IndE tap)
        er (_      3:      // er at end of word context
     _) err (A     Er
     &) ere (_     3
        ere (_     3:
        er         3:

// ================================================================
// GROUP: r
// Fix: keep r as a tap between vowels (e.g. "very", "sorry", "carry")
// Override the en_rules rule: e) r (_ → 3  (which drops the r)
// ================================================================

.group r
        r          r
        rr         r
     _) rh (Y      r
     _) rw (a      r%U
     r) r (_
        r (_N      3
     C) rr (_N     3
     @) r (B       @
     C) rh         r
        rheu       ru:
        rhi (n#    raI
        rhi (z     raI
     _) rho (d     roU
     _) rhodo (@   roUd@
     _) rho (t     roU
     _) rhu        ru:
        rhyth      rID
     _) rm (A      ,A@Em
        rrhea      r'i@
        rrhoea     r'i@
     _) ru (bL01   ru:
     _) rule (@    ru:l
     _) run (a     rVn
     _) run (o     rVn
  &ant) ry (_S2    ri
   &an) ry (_S2    ri
  &ant) ries (_S4  riz

// ================================================================
// GROUP: th
// th → t (dental) for Indian English
// ================================================================

.group th
        th         T
     _) the (_     D@
     _) the (C     D@
        the (C     D@
        thi (s_    DIs
        thi (s     DIs
        th (e_     D
