        sh (_      S
        sh         S

// ================================================================
// GROUP: ch
// Preserve affricate /tʃ/
// Examples: chair, choice
// ================================================================

.group ch
        ch (A      tS
        ch (_      tS
        ch         tS

// ================================================================
// GROUP: or
// Rhotic vowel preservation
// Examples: more, door, before
// ================================================================

.group or
        or (_      or
        or (C      or
        or         or

// ================================================================
// GROUP: e
// Preserve full vowel /e/
// Examples: pen, bed
// ================================================================

.group e
