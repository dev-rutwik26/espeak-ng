// This file is UTF-8 encoded

// Conditional rules
// ?2  Use voiceless [w#] for "wh"
// ?3  General American
// ?!3  Not General American
// ?5  split [3:] er [3:], ir [IR], ur [VR]
// ?6  'one' = [wVn], 'of' = [Vv] (now uses phoneme [02])
// ?7  Scottish
// ?8  Use full vowel, not schwa in some word endings


// Group Y, vowels + y
.L01  l r
.L02  i y
.L03  a i o u   // vowel, not 'e'
.L04  e i y
.L05  c g k
.L06  s z
.L07  b d g  m n r  bE dE lE nE   // before voiced s in -sman
.L08  t d s z n x    // dental, drop [j] before [u:]
.L10  graph log met scop  // scientific endings
.L11  ä ö ü ae ø


.replace
   æ   ae
   œ   oe

   ﬀ   ff     // ligatures
   ﬁ   fi
   ﬂ   fl
   ﬅ   st
   ﬆ   st

   ά   α      // some of polytonic greek to plain greek letters (list in el_rules is much longer)
   έ   ε
   ή   η
   ί   ι
   ϊ   ι
   ό   ο
   ύ   υ
   ϋ   υ
   ΰ   υ
   ώ   ω
   ʻ   '     // Replace Hawaiian okina to apostrophe FIXME — that should be done globally for all languages

